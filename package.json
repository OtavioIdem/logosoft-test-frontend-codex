{
    "name": "logosoft-frontend",
    "version": "1.11.0-a.8.b9",
    "logosoftVersion": "1.11.0a8b9",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "npm run validate:source && next build",
        "start": "next start",
        "lint": "next lint",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write \"{app,components,config,features,hooks,layout,lib,providers,tests,types}/**/*.{js,ts,tsx,d.ts}\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:unit": "vitest run tests/unit tests/components",
        "test:component": "vitest run tests/components",
        "validate": "npm run validate:source && npm run typecheck && npm run lint && npm run test",
        "validate:source": "node scripts/validate-source.mjs",
        "test:e2e:critical": "playwright test tests/e2e/auth.spec.ts tests/e2e/logosoft-critical-flows.spec.ts",
        "test:e2e:ui": "playwright test --ui"
    },
    "dependencies": {
        "@hookform/resolvers": "^3.9.0",
        "@tanstack/react-query": "^5.59.16",
        "axios": "^1.7.7",
        "chart.js": "4.2.1",
        "next": "13.4.8",
        "primeflex": "^3.3.1",
        "primeicons": "^6.0.1",
        "primereact": "10.2.1",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-hook-form": "^7.53.0",
        "react-transition-group": "^4.4.5",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@playwright/test": "^1.48.2",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.0.1",
        "@testing-library/user-event": "^14.5.2",
        "@types/node": "^24.0.0",
        "@types/react": "18.2.12",
        "@types/react-dom": "18.2.5",
        "@types/react-transition-group": "^4.4.12",
        "@vitejs/plugin-react": "^4.3.3",
        "eslint": "8.43.0",
        "eslint-config-next": "13.4.8",
        "jsdom": "^25.0.1",
        "prettier": "^2.8.8",
        "sass": "^1.63.4",
        "typescript": "^5.8.3",
        "vite": "^5.4.11",
        "vitest": "^2.1.3"
    },
    "engines": {
        "node": ">=24 <25",
        "npm": ">=11 <12"
    },
    "packageManager": "npm@11.12.1"
}
