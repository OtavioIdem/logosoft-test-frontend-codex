{
    "name": "logosoft-frontend",
    "version": "1.11.0-a.8.b46",
    "logosoftVersion": "1.11.0a8b46",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "npm run validate:source && next build",
        "start": "next start",
        "lint": "next lint",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write \"{app,components,config,features,hooks,layout,lib,providers,tests,types}/**/*.{js,ts,tsx,d.ts}\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:unit": "vitest run tests/unit tests/components",
        "test:component": "vitest run tests/components",
        "validate": "npm run validate:source && npm run typecheck && npm run lint && npm run test",
        "validate:source": "node scripts/validate-source.mjs",
        "validate:ci": "node scripts/validate-ci-gates.mjs",
        "test:e2e:critical": "playwright test tests/e2e/auth.spec.ts tests/e2e/logosoft-critical-flows.spec.ts",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:fiscal": "playwright test tests/e2e/fiscal.spec.ts",
        "test:contract:fiscal": "playwright test --config=playwright.contract.config.ts",
        "test:e2e:fiscal:backend": "playwright test --config=playwright.backend-e2e.config.ts",
        "validate:fiscal:production": "node scripts/validate-fiscal-production.mjs",
        "validate:guid-references": "node scripts/validate-guid-references.mjs",
        "ci:gates": "npm run validate:source && npm run validate:skills && npm run validate:mocks-isolation && npm run validate:backend-controlled && npm run validate:controlled-seeds && npm run validate:integrated-runbook && npm run validate:backend-seed-reset && npm run validate:assisted-e2e && npm run validate:integrated-e2e && npm run validate:operational-contracts && npm run validate:backend-contract-map && npm run validate:guid-references && npm run validate:fiscal:production && npm run typecheck && npm run lint && npm run test:unit && npm run build && npx playwright install chromium && npm run test:e2e:fiscal && npm run test:contract:fiscal && npm run test:contract:operational && npm run test:e2e:fiscal:backend",
        "validate:skills": "node scripts/validate-skills.mjs",
        "validate:mocks-isolation": "node scripts/validate-mocks-isolation.mjs",
        "validate:backend-controlled": "node scripts/validate-backend-controlled.mjs",
        "test:contract:operational": "playwright test --config=playwright.operational-contract.config.ts",
        "validate:operational-contracts": "node scripts/validate-operational-contracts.mjs",
        "validate:integrated-e2e": "node scripts/validate-integrated-e2e.mjs",
        "test:e2e:integrated:backend": "playwright test --config=playwright.integrated-e2e.config.ts",
        "validate:controlled-seeds": "node scripts/validate-controlled-seeds.mjs",
        "validate:integrated-runbook": "node scripts/validate-integrated-runbook.mjs",
        "validate:backend-seed-reset": "node scripts/validate-backend-seed-reset.mjs",
        "prepare:e2e:integrated:seed": "node scripts/prepare-integrated-e2e-seed.mjs",
        "validate:assisted-e2e": "node scripts/validate-assisted-e2e.mjs",
        "report:e2e:integrated:assisted": "node scripts/create-integrated-e2e-assisted-report.mjs",
        "validate:backend-contract-map": "node scripts/validate-backend-contract-map.mjs",
        "report:backend-contract-map": "node scripts/validate-backend-contract-map.mjs --report"
    },
    "dependencies": {
        "@hookform/resolvers": "^3.9.0",
        "@tanstack/react-query": "^5.59.16",
        "axios": "^1.7.7",
        "chart.js": "4.2.1",
        "next": "13.4.8",
        "primeflex": "^3.3.1",
        "primeicons": "^6.0.1",
        "primereact": "10.2.1",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-hook-form": "^7.53.0",
        "react-transition-group": "^4.4.5",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@playwright/test": "^1.48.2",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.0.1",
        "@testing-library/user-event": "^14.5.2",
        "@types/node": "^24.0.0",
        "@types/react": "18.2.12",
        "@types/react-dom": "18.2.5",
        "@types/react-transition-group": "^4.4.12",
        "@vitejs/plugin-react": "^4.3.3",
        "eslint": "8.43.0",
        "eslint-config-next": "13.4.8",
        "jsdom": "^25.0.1",
        "prettier": "^2.8.8",
        "sass": "^1.63.4",
        "typescript": "^5.8.3",
        "vite": "^5.4.11",
        "vitest": "^2.1.3"
    },
    "engines": {
        "node": ">=24 <25",
        "npm": ">=11 <12"
    },
    "packageManager": "npm@11.12.1"
}
