# Ambiente controlado para validação frontend/backend.
# Nunca preencha este arquivo versionado com token real, senha, certificado ou segredo.
# Copie para .env.backend-controlled.local e preencha localmente.

NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME=logosoft
NEXT_PUBLIC_APP_ENV=test
NEXT_PUBLIC_APP_VERSION=1.11.0a8b30
PLAYWRIGHT_BACKEND_BASE_URL=http://127.0.0.1:3000
LOGOSOFT_E2E_USE_EXISTING_FRONTEND=false

# Contrato fiscal read-only/controlado.
LOGOSOFT_CONTRACT_API_URL=http://localhost:8080
LOGOSOFT_CONTRACT_ACCESS_TOKEN=
LOGOSOFT_CONTRACT_EMPRESA_ID=
LOGOSOFT_CONTRACT_FILIAL_ID=
LOGOSOFT_CONTRACT_NOTA_FISCAL_ID=
LOGOSOFT_CONTRACT_UF_AUTORIZADORA=SP
LOGOSOFT_CONTRACT_RUN_STATUS_SERVICO=false
LOGOSOFT_CONTRACT_RUN_EXPORT_CSV=false
LOGOSOFT_CONTRACT_EXPORT_CSV_MOTIVO=Contrato fiscal frontend/backend controlado

# E2E fiscal mutável/controlado. Deve usar homologação/sandbox/base descartável.
LOGOSOFT_E2E_API_URL=http://localhost:8080
LOGOSOFT_E2E_ACCESS_TOKEN=
LOGOSOFT_E2E_REFRESH_TOKEN=
LOGOSOFT_E2E_EMPRESA_ID=
LOGOSOFT_E2E_FILIAL_ID=
LOGOSOFT_E2E_PEDIDO_VENDA_ID=
LOGOSOFT_E2E_RUN_BACKEND_FISCAL=false
LOGOSOFT_E2E_UF_AUTORIZADORA=SP
LOGOSOFT_E2E_SERIE_NOTA=1
LOGOSOFT_E2E_CFOP_PADRAO=5102
LOGOSOFT_E2E_UNIDADE_COMERCIAL_PADRAO=UN
LOGOSOFT_E2E_SCHEMA_SET_NAME=NFe-4.00
LOGOSOFT_E2E_NUMERO_NOTA=
LOGOSOFT_E2E_PRIMEIRA_DATA_VENCIMENTO=
LOGOSOFT_E2E_PERMISSIONS=
